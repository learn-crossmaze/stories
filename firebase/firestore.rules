// GENERATED from firebase/rules-src/firestore.rules.tmpl. Edit the template, then `npm run gen:rbac`.
rules_version = '2';

// Stories — Firestore Security Rules. See docs/RBAC.md and docs/FIRESTORE_RULES.md.
//
// Policy: deny by default. Every invariant-bearing document is written only by
// Cloud Functions (the Admin SDK bypasses rules), so these rules are almost all
// read rules. Authorization comes from custom claims synced from
// users/{uid}/memberships/{orgId}:
//   { v, sa: bool, o: { <orgId>: { r: [roleCodes], b: [branchIds] | ['*'] } } }
service cloud.firestore {
  match /databases/{database}/documents {

    // GENERATED permission → role-code map (tools/rbac/generate.mjs). Do not edit here.
    function perms() {
      return {
        'org.manage': [],
        'branches.view': ['HO', 'FIN', 'HR', 'FO', 'BM', 'LIB', 'DEL', 'EMP'],
        'branches.manage': ['HO', 'FO'],
        'departments.manage': ['HO', 'HR', 'FO'],
        'staff.view': ['HO', 'HR', 'FO', 'BM'],
        'staff.manageRoles': ['HO', 'HR', 'FO', 'BM'],
        'audit.view': ['HO', 'FIN', 'HR', 'FO', 'BM'],
        'config.manage': ['HO'],
        'books.view': ['HO', 'FIN', 'FO', 'BM', 'LIB', 'DEL'],
        'books.create': ['HO'],
        'books.edit': ['HO'],
        'copies.manage': ['HO', 'FO', 'BM', 'LIB'],
        'books.transfer': ['HO', 'FO', 'BM', 'LIB'],
        'copies.writeOff': ['HO', 'FIN', 'FO', 'BM'],
        'members.view': ['HO', 'FIN', 'FO', 'BM', 'LIB'],
        'members.manage': ['HO', 'FIN', 'FO', 'BM', 'LIB'],
        'loans.issue': ['FO', 'BM', 'LIB'],
        'loans.return': ['FO', 'BM', 'LIB'],
        'exchanges.process': ['FO', 'BM', 'LIB'],
        'reservations.manage': ['FO', 'BM', 'LIB'],
        'subscriptions.manage': ['HO', 'FIN', 'FO', 'BM', 'LIB'],
        'plans.manage': ['HO'],
        'deposits.view': ['HO', 'FIN', 'FO', 'BM', 'LIB'],
        'deposits.adjust': ['FIN', 'FO', 'BM'],
        'deposits.approve': ['FIN'],
        'deposits.refund': ['FIN'],
        'payments.view': ['HO', 'FIN', 'FO', 'BM', 'LIB'],
        'payments.recordOffline': ['HO', 'FIN', 'FO', 'BM', 'LIB'],
        'payments.refund': ['FIN'],
        'delivery.manage': ['FO', 'BM', 'LIB'],
        'delivery.assign': ['FO', 'BM', 'LIB'],
        'delivery.execute': ['DEL'],
        'employees.view': ['HO', 'HR', 'FO', 'BM'],
        'employees.edit': ['HO', 'HR', 'FO'],
        'employees.privateData': ['FIN', 'HR'],
        'attendance.manage': ['HR', 'FO', 'BM'],
        'corrections.approve': ['HR', 'FO', 'BM'],
        'leave.approve': ['HR', 'FO', 'BM'],
        'payroll.run': ['HR', 'FO'],
        'payroll.approve': ['FIN', 'FO'],
        'tasks.assign': ['HO', 'FO', 'BM'],
        'tasks.approve': ['HO', 'FO', 'BM'],
        'tasks.skip': ['HO', 'FO', 'BM'],
        'tasks.execute': ['EMP', 'BM', 'LIB', 'DEL'],
        'sops.edit': ['HO', 'FO', 'BM'],
        'sops.publish': ['HO'],
        'reports.view': ['HO', 'FIN', 'HR', 'FO', 'BM']
      };
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSA() {
      return signedIn() && request.auth.token.get('sa', false) == true;
    }

    function orgClaims(o) {
      return request.auth.token.get('o', {}).get(o, null);
    }

    // Org isolation: the caller holds some role in organization o.
    function inOrg(o) {
      return isSA() || (signedIn() && orgClaims(o) != null);
    }

    function allBranches(o) {
      return isSA() || (signedIn() && orgClaims(o) != null && '*' in orgClaims(o).b);
    }

    // Branch isolation: branch b is inside the caller's branch scope in org o.
    function inBranch(o, b) {
      return isSA() || (signedIn() && orgClaims(o) != null && orgClaims(o).b.hasAny(['*', b]));
    }

    // RBAC: one of the caller's roles in org o grants permission perm.
    function can(o, perm) {
      return isSA() || (signedIn() && orgClaims(o) != null && orgClaims(o).r.hasAny(perms()[perm]));
    }

    // Checks "all branches" before touching `b`, so org-wide staff can run
    // unfiltered list queries (b comes from resource.data).
    function canAt(o, b, perm) {
      return can(o, perm) && (allBranches(o) || inBranch(o, b));
    }

    // ---------------------------------------------------------------- users
    // Profile: owner reads it; created/maintained by functions only.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow write: if false;

      // Authoritative roles per organization (functions only).
      match /memberships/{orgId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Staff lists query memberships across users (collection group). Org-wide
    // staff viewers see the whole org; branch-scoped viewers only memberships
    // that overlap their branches (their query must filter the same way).
    // (Checks resource.data.orgId, not the document id: a collection-group
    // query can only be authorized from fields it filters on.)
    match /{path=**}/memberships/{membershipId} {
      allow read: if can(resource.data.orgId, 'staff.view')
        && (allBranches(resource.data.orgId)
            || resource.data.branchIds.hasAny(orgClaims(resource.data.orgId).b));
    }

    // ---------------------------------------------------------------- catalogue
    // Shared across organizations; readable by any signed-in user, written
    // only by functions (head office permission). Indexes/counters stay closed.
    match /books/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /authors/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /publishers/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------- orgs
    match /orgs/{o} {
      allow get: if inOrg(o);
      allow list: if isSA();
      allow write: if false;

      match /branches/{b} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      match /branches/{b}/locations/{l} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      match /departments/{d} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // ------------------------------------------------ library (Phase 1)
      // Every read is scoped to a branch the caller works at; list queries
      // must filter on the same branch field. All writes go through functions.

      // Copies: visible at the branch holding them and at the owning branch.
      // (`resource == null`: looking up a document that doesn't exist only
      // reveals that it doesn't exist, so the page can say "not found".)
      match /copies/{c} {
        allow get: if resource == null && can(o, 'books.view');
        allow read: if canAt(o, resource.data.currentBranchId, 'books.view')
          || canAt(o, resource.data.owningBranchId, 'books.view');
        allow write: if false;

        match /events/{e} {
          allow read: if canAt(o, get(/databases/$(database)/documents/orgs/$(o)/copies/$(c)).data.currentBranchId, 'books.view');
          allow write: if false;
        }
      }

      match /members/{m} {
        allow get: if resource == null && can(o, 'members.view');
        allow read: if canAt(o, resource.data.homeBranchId, 'members.view');
        allow write: if false;
      }

      match /plans/{p} {
        allow read: if inOrg(o);
        allow write: if false;

        match /versions/{v} {
          allow read: if inOrg(o);
          allow write: if false;
        }
      }

      match /subscriptions/{s} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      match /payments/{p} {
        allow read: if canAt(o, resource.data.branchId, 'payments.view');
        allow write: if false;
      }

      // Members get an account with their first deposit; before that the
      // lookup finds nothing (allowed, reveals nothing).
      match /depositAccounts/{m} {
        allow get: if resource == null && can(o, 'deposits.view');
        allow read: if canAt(o, resource.data.branchId, 'deposits.view');
        allow write: if false;

        // Authorized by the account's branch so a member's ledger can be listed as-is.
        match /transactions/{t} {
          allow read: if canAt(o, get(/databases/$(database)/documents/orgs/$(o)/depositAccounts/$(m)).data.branchId, 'deposits.view');
          allow write: if false;
        }
      }

      match /depositAdjustments/{a} {
        allow read: if canAt(o, resource.data.branchId, 'deposits.view');
        allow write: if false;
      }

      match /loans/{l} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      match /exchanges/{x} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      match /reservations/{r} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      // Transfers: visible to both the sending and the receiving branch.
      match /transfers/{t} {
        allow read: if canAt(o, resource.data.fromBranchId, 'books.view')
          || canAt(o, resource.data.toBranchId, 'books.view');
        allow write: if false;
      }

      match /config/{k} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // Org-wide auditors see everything; branch-scoped auditors only entries
      // for their branches (queries must filter on branchId).
      match /auditLogs/{id} {
        allow read: if can(o, 'audit.view')
          && (allBranches(o) || inBranch(o, resource.data.get('branchId', '')));
        allow write: if false;
      }
    }

    // Everything else is denied until its module defines explicit rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
