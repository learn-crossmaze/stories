rules_version = '2';

// Stories — Firestore Security Rules. See docs/RBAC.md and docs/FIRESTORE_RULES.md.
//
// Policy: deny by default. Every invariant-bearing document is written only by
// Cloud Functions (the Admin SDK bypasses rules), so these rules are almost all
// read rules. Authorization comes from custom claims synced from
// users/{uid}/memberships/{orgId}:
//   { v, sa: bool, o: { <orgId>: { r: [roleCodes], b: [branchIds] | ['*'] } } }
service cloud.firestore {
  match /databases/{database}/documents {

    /*@@PERMISSIONS@@*/

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSA() {
      return signedIn() && request.auth.token.get('sa', false) == true;
    }

    function orgClaims(o) {
      return request.auth.token.get('o', {}).get(o, null);
    }

    // Org isolation: the caller holds some role in organization o.
    function inOrg(o) {
      return isSA() || (signedIn() && orgClaims(o) != null);
    }

    function allBranches(o) {
      return isSA() || (signedIn() && orgClaims(o) != null && '*' in orgClaims(o).b);
    }

    // Branch isolation: branch b is inside the caller's branch scope in org o.
    function inBranch(o, b) {
      return isSA() || (signedIn() && orgClaims(o) != null && orgClaims(o).b.hasAny(['*', b]));
    }

    // RBAC: one of the caller's roles in org o grants permission perm.
    function can(o, perm) {
      return isSA() || (signedIn() && orgClaims(o) != null && orgClaims(o).r.hasAny(perms()[perm]));
    }

    // Employee documents: the employee (uid), or HR (verifiers and employee
    // editors) whose scope covers branch b (null = head office: all branches).
    // Builds the permission map once, because a list query evaluates every
    // branch of every matching rule within one expression budget.
    function seesDocuments(o, b, uid) {
      let p = perms();
      let c = orgClaims(o);
      return (signedIn() && uid != null && uid == request.auth.uid) || isSA()
        || (c != null
          && c.r.hasAny(p['documents.verify'].concat(p['employees.edit']))
          && ('*' in c.b || b in c.b));
    }

    // Checks "all branches" before touching `b`, so org-wide staff can run
    // unfiltered list queries (b comes from resource.data).
    function canAt(o, b, perm) {
      return can(o, perm) && (allBranches(o) || inBranch(o, b));
    }

    // ---------------------------------------------------------------- users
    // Profile: owner reads it; created/maintained by functions only.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow write: if false;

      // Authoritative roles per organization (functions only).
      match /memberships/{orgId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // In-app notifications (functions write them); the owner may only mark one read.
      match /notifications/{n} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }
    }

    // Staff lists query memberships across users (collection group). Org-wide
    // staff viewers see the whole org; branch-scoped viewers only memberships
    // that overlap their branches (their query must filter the same way).
    // (Checks resource.data.orgId, not the document id: a collection-group
    // query can only be authorized from fields it filters on.)
    match /{path=**}/memberships/{membershipId} {
      allow read: if can(resource.data.orgId, 'staff.view')
        && (allBranches(resource.data.orgId)
            || resource.data.branchIds.hasAny(orgClaims(resource.data.orgId).b));
    }

    // Employee documents (orgs/{o}/employees/{e}/documents/{d}). HR (verifiers
    // and employee editors) at the employee's branch and the employee see the
    // records; the files themselves are private in Storage and only come back
    // through the audited documents-open call. Queue queries run as a
    // collection group filtered on orgId (and branchId for branch staff).
    match /{path=**}/documents/{d} {
      allow read: if seesDocuments(resource.data.orgId, resource.data.get('branchId', null), resource.data.get('employeeUid', null));
      allow write: if false;
    }

    // ---------------------------------------------------------------- catalogue
    // Shared across organizations; readable by any signed-in user, written
    // only by functions (head office permission). Indexes/counters stay closed.
    match /books/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /authors/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /publishers/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Catalogue-wide settings (config/numbering: book code pattern).
    match /config/{k} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------- orgs
    match /orgs/{o} {
      allow get: if inOrg(o);
      allow list: if isSA();
      allow write: if false;

      match /branches/{b} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      match /branches/{b}/locations/{l} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      match /departments/{d} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // ------------------------------------------------ library (Phase 1)
      // Every read is scoped to a branch the caller works at; list queries
      // must filter on the same branch field. All writes go through functions.

      // Copies: visible at the branch holding them and at the owning branch.
      // (`resource == null`: looking up a document that doesn't exist only
      // reveals that it doesn't exist, so the page can say "not found".)
      match /copies/{c} {
        allow get: if resource == null && can(o, 'books.view');
        allow read: if canAt(o, resource.data.currentBranchId, 'books.view')
          || canAt(o, resource.data.owningBranchId, 'books.view');
        allow write: if false;

        match /events/{e} {
          allow read: if canAt(o, get(/databases/$(database)/documents/orgs/$(o)/copies/$(c)).data.currentBranchId, 'books.view');
          allow write: if false;
        }
      }

      match /members/{m} {
        allow get: if resource == null && can(o, 'members.view');
        allow read: if canAt(o, resource.data.homeBranchId, 'members.view');
        allow write: if false;
      }

      match /plans/{p} {
        allow read: if inOrg(o);
        allow write: if false;

        match /versions/{v} {
          allow read: if inOrg(o);
          allow write: if false;
        }
      }

      match /subscriptions/{s} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      match /payments/{p} {
        allow read: if canAt(o, resource.data.branchId, 'payments.view');
        allow write: if false;
      }

      // Online payment requests (Razorpay links / UPI QR codes), live-watched by the console.
      match /paymentRequests/{r} {
        allow read: if canAt(o, resource.data.branchId, 'payments.view');
        allow write: if false;
      }

      // Branch secrets (Razorpay key secret, webhook secret): functions only.
      match /branches/{b}/private/{doc} {
        allow read, write: if false;
      }

      // Members get an account with their first deposit; before that the
      // lookup finds nothing (allowed, reveals nothing).
      match /depositAccounts/{m} {
        allow get: if resource == null && can(o, 'deposits.view');
        allow read: if canAt(o, resource.data.branchId, 'deposits.view');
        allow write: if false;

        // Authorized by the account's branch so a member's ledger can be listed as-is.
        match /transactions/{t} {
          allow read: if canAt(o, get(/databases/$(database)/documents/orgs/$(o)/depositAccounts/$(m)).data.branchId, 'deposits.view');
          allow write: if false;
        }
      }

      match /depositAdjustments/{a} {
        allow read: if canAt(o, resource.data.branchId, 'deposits.view');
        allow write: if false;
      }

      match /loans/{l} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      match /exchanges/{x} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      match /reservations/{r} {
        allow read: if canAt(o, resource.data.branchId, 'members.view');
        allow write: if false;
      }

      // Transfers: visible to both the sending and the receiving branch.
      match /transfers/{t} {
        allow read: if canAt(o, resource.data.fromBranchId, 'books.view')
          || canAt(o, resource.data.toBranchId, 'books.view');
        allow write: if false;
      }

      match /config/{k} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // ------------------------------------------------ HRMS (docs/HRMS.md)
      // Employee records: employee viewers at the employee's branch (org-wide
      // viewers also see head-office staff, who have no branch) and the
      // employee themselves. List queries filter on branchId, or on uid for
      // "my record". All writes go through functions.
      function employee(o, e) {
        return get(/databases/$(database)/documents/orgs/$(o)/employees/$(e)).data;
      }
      function isEmployee(rec) {
        return signedIn() && rec.get('uid', null) == request.auth.uid;
      }

      match /employees/{e} {
        allow read: if canAt(o, resource.data.branchId, 'employees.view') || isEmployee(resource.data);
        allow write: if false;

        match /history/{h} {
          allow read: if canAt(o, employee(o, e).branchId, 'employees.view') || isEmployee(employee(o, e));
          allow write: if false;
        }

        // Personal and statutory details (bank account shown masked).
        match /private/profile {
          allow read: if canAt(o, employee(o, e).branchId, 'employees.privateData') || isEmployee(employee(o, e));
          allow write: if false;
        }

        // Full bank account number: functions only (revealed through an audited call).
        match /private/bank {
          allow read, write: if false;
        }

        // One employee's documents (the profile's Documents tab lists them unfiltered).
        match /documents/{d} {
          allow read: if seesDocuments(o, employee(o, e).get('branchId', null), employee(o, e).get('uid', null));
          allow write: if false;
        }
      }

      match /designations/{d} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // Attendance (docs/HRMS.md §8). Records, corrections and monthly summaries
      // are visible to attendance viewers at the employee's branch and to the
      // employee; queries filter on branchId (branch staff) or employeeUid (self).
      match /attendance/{r} {
        allow read: if canAt(o, resource.data.branchId, 'attendance.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      match /attendanceCorrections/{c} {
        allow read: if canAt(o, resource.data.branchId, 'attendance.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      match /attendanceSummaries/{s} {
        allow read: if canAt(o, resource.data.branchId, 'attendance.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      // Leave (docs/HRMS.md §9): requests, balances and the ledger follow the
      // attendance rule; leave types are org settings.
      match /leaveRequests/{r} {
        allow read: if canAt(o, resource.data.branchId, 'attendance.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      match /leaveBalances/{bal} {
        allow read: if canAt(o, resource.data.branchId, 'attendance.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      match /leaveLedger/{en} {
        allow read: if canAt(o, resource.data.branchId, 'attendance.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      match /leaveTypes/{t} {
        allow read: if inOrg(o);
        allow write: if false;
      }
      // Payroll (docs/HRMS.md §10). Salaries, monthly inputs and runs are for
      // salary viewers at the employee's branch (employees see their own
      // salary); payslips for those who see all payslips, and for the employee
      // once published (their queries filter on employeeUid and published).
      match /payrollSettings/{v} {
        allow read: if inOrg(o);
        allow write: if false;
      }
      match /salaries/{s} {
        allow read: if canAt(o, resource.data.branchId, 'salary.view') || (signedIn() && resource.data.employeeUid == request.auth.uid);
        allow write: if false;
      }
      match /payrollInputs/{i} {
        allow read: if canAt(o, resource.data.branchId, 'salary.view');
        allow write: if false;
      }
      match /payrollRuns/{run} {
        allow read: if canAt(o, resource.data.branchId, 'salary.view');
        allow write: if false;
      }
      match /payslips/{p} {
        allow read: if canAt(o, resource.data.branchId, 'payslips.viewAll') || (signedIn() && resource.data.employeeUid == request.auth.uid && resource.data.published == true);
        allow write: if false;
      }
      match /attendanceLocks/{l} {
        allow read: if inOrg(o);
        allow write: if false;
      }
      match /shifts/{sh} {
        allow read: if inOrg(o);
        allow write: if false;
      }
      match /holidays/{h} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // Document types (defaults live in code; these override or add to them).
      match /documentTypes/{t} {
        allow read: if inOrg(o);
        allow write: if false;
      }

      // Org-wide auditors see everything; branch-scoped auditors only entries
      // for their branches (queries must filter on branchId).
      match /auditLogs/{id} {
        allow read: if can(o, 'audit.view')
          && (allBranches(o) || inBranch(o, resource.data.get('branchId', '')));
        allow write: if false;
      }
    }

    // Everything else is denied until its module defines explicit rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
