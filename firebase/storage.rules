rules_version = '2';

// Stories — Storage Security Rules (foundation). Deny by default; each module
// adds narrow path rules (see docs/RBAC.md §7).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Employee documents (hr/{orgId}/{employeeId}/…) stay closed to every
    // client: they are uploaded and opened only through the documents-* calls,
    // which check permissions and audit each opening.

    // Book covers are public (catalogue artwork). Uploads go through the
    // books-setCover function, which checks catalogue permissions.
    match /covers/{bookId}/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
