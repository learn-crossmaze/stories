# Copy to .env.production and fill in from Firebase console → Project settings →
# General → Your apps → (web app) → SDK setup and configuration → Config.
# These values are public (they ship in the browser bundle); never put secrets here.
VITE_STORIES_FLAVOR=prod
# The project ID is permanent ("stories-for-all" is only its CLI alias). After app.storiesforall.in is connected
# in Hosting, set the auth domain to it so sign-in windows show app.storiesforall.in (docs/ENVIRONMENTS.md §7).
VITE_FIREBASE_PROJECT_ID=stories-by-crossmaze
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_AUTH_DOMAIN=stories-by-crossmaze.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=stories-by-crossmaze.firebasestorage.app
VITE_FIREBASE_MEASUREMENT_ID=
VITE_APP_CHECK_RECAPTCHA_ENTERPRISE_KEY=
