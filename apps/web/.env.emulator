# Local Firebase Emulator Suite. `demo-` project IDs never reach a cloud project.
VITE_STORIES_FLAVOR=dev
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=localhost
VITE_FIREBASE_PROJECT_ID=demo-stories
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_AUTH_DOMAIN=demo-stories.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-stories.appspot.com
# Shows "Continue with Zoho Mail"; the Auth emulator simulates the Zoho sign-in.
VITE_ZOHO_SIGN_IN=true
# The member area (npm run dev:member) and the staff app (npm run dev) link to each other.
VITE_MEMBER_URL=http://localhost:8083/account
VITE_STAFF_URL=http://localhost:8081
