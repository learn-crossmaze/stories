# Where "Become a member", "Sign in" and book links go: the member area, served by this website at /account
# (apps/web member pages, built by `npm run build:site`; docs/SITE.md).
VITE_APP_URL=/account
# Public enquiry address shown on Contact and Franchise (e.g. a Zoho Mail alias). Empty: those pages point to the branches.
VITE_CONTACT_EMAIL=
# Default look: "candy" (pastel colour flow, like crossmaze.in) or "library" (white with light gradients and
# library artwork). Visitors can switch in the footer; ?theme=candy or ?theme=library previews one (docs/SITE.md).
VITE_SITE_THEME=candy
