{
  "name": "stories",
  "private": true,
  "description": "Stories platform tooling (Firebase CLI, emulators, rules tests)",
  "scripts": {
    "firebase": "firebase",
    "emulators": "firebase emulators:start --project demo-stories",
    "test:rules": "firebase emulators:exec --project demo-stories --only firestore \"vitest run\"",
    "web:emulator": "cd apps/stories_app && flutter run -d web-server --web-port 8081 --dart-define-from-file=config/emulator.json"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^14.0.0",
    "vitest": "^5.0.2"
  }
}
