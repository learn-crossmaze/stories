{
  "name": "stories",
  "private": true,
  "description": "Stories library web app, hosted on Firebase",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test:web": "npm run test -w apps/web",
    "emulators": "firebase emulators:start --project demo-stories",
    "test:rules": "firebase emulators:exec --project demo-stories --only firestore \"vitest run\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0",
    "vitest": "^5.0.2"
  }
}
