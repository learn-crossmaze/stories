{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "test",
        "src"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "apps/web/dist",
      "ignore": [
        "**/.*",
        "**/*.map"
      ],
      "rewrites": [
        {
          "source": "/!(assets)",
          "destination": "/index.html"
        },
        {
          "source": "/!(assets)/**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=(self), camera=(self), microphone=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "site",
      "public": "apps/site/dist",
      "ignore": [
        "**/.*",
        "**/*.map"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/account",
          "destination": "/account/member.html"
        },
        {
          "source": "/account/!(assets)",
          "destination": "/account/member.html"
        },
        {
          "source": "/account/!(assets)/**",
          "destination": "/account/member.html"
        },
        {
          "source": "/api/public",
          "function": {
            "functionId": "sitePublic",
            "region": "asia-south1"
          }
        },
        {
          "source": "/blog",
          "function": {
            "functionId": "sitePages",
            "region": "asia-south1"
          }
        },
        {
          "source": "/blog/**",
          "function": {
            "functionId": "sitePages",
            "region": "asia-south1"
          }
        },
        {
          "source": "/branches/*",
          "function": {
            "functionId": "sitePages",
            "region": "asia-south1"
          }
        },
        {
          "source": "/about",
          "function": {
            "functionId": "sitePages",
            "region": "asia-south1"
          }
        },
        {
          "source": "/preview/**",
          "function": {
            "functionId": "sitePages",
            "region": "asia-south1"
          }
        },
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "sitePages",
            "region": "asia-south1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=(), camera=(), microphone=()"
            }
          ]
        },
        {
          "source": "/account/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/fonts/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_t/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "functions": {
      "port": 5001
    }
  }
}
